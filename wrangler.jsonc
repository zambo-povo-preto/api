{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "account_id": "78c04ce106fa0ed7d0fa7e9fd1cd7c5f",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DOMAIN": "localhost",
    "ENVIRONMENT": "development",
    "SITE_BASE_URL": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zambo-db-dev",
      "database_id": "50af40d7-b758-4afc-8676-97aebdbb27fa",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "zambo-attachments-dev",
      "remote": false
    }
  ],
  "env": {
    "production": {
      "route": {
        "custom_domain": true,
        "pattern": "api.xn--zambpovopreto-slb.com.br",
        "zone_name": "xn--zambpovopreto-slb.com.br"
      },
      "workers_dev": false,
      "vars": {
        "DOMAIN": "xn--zambpovopreto-slb.com.br",
        "ENVIRONMENT": "production",
        "SITE_BASE_URL": "https://site.xn--zambpovopreto-slb.com.br"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zambo-db-production",
          "database_id": "2dce7a09-2594-48d3-a57c-12abf020f845",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "zambo-attachments-production",
          "remote": true
        }
      ]
    }
  }
}
